# Configurações de Conexão com o Supabase / PostgreSQL
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.seu_projeto
SUPABASE_DB_PASSWORD=sua_senha_aqui

# URL completa de conexão
DATABASE_URL=postgresql://postgres.seu_projeto:sua_senha_aqui@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
