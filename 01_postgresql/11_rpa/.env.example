# ==============================================================================
# CONFIGURAÇÃO DE CONEXÃO DOS BANCOS DE DADOS DO RPA
# ==============================================================================

# Banco 1 (Instancia Operacional - Logistica Operacional (DB1))
# Exemplo DB1 (Operacional): postgresql+psycopg2://operador:senha_segura@pg-operacional.efficientia.internal:5432/efficientia_operacional?sslmode=prefer
DB1_URL=postgresql+psycopg2://operador:senha_segura@pg-operacional.efficientia.internal:5432/efficientia_operacional?sslmode=prefer

# Banco 2 (Instancia Corporativa - Corporativo / Web / Mobile (DB2))
# Exemplo DB2 (Corporativo): postgresql+psycopg2://corporativo:senha_segura@pg-corporativo.efficientia.internal:5432/efficientia_corporativo?sslmode=prefer
DB2_URL=postgresql+psycopg2://corporativo:senha_segura@pg-corporativo.efficientia.internal:5432/efficientia_corporativo?sslmode=prefer
# Configurações de Execução do RPA
SYNC_INTERVAL_SECONDS=30
LOG_LEVEL=INFO

# Tabelas customizadas (opcional, defaults: empresa / usuario / motorista)
DB1_EMPRESA_TABLE=empresa
DB1_MOTORISTA_TABLE=motorista
DB2_EMPRESA_TABLE=tb_empresa
DB2_MOTORISTA_TABLE=tb_usuario
