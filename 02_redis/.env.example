# Configuração do Ambiente
APP_ENV=development

# Conexão com o Redis (Upstash - Utilizar formato com TLS rediss://)
REDIS_URL=rediss://default:sua_senha_upstash@seu-endpoint.upstash.io:6379

# Conexão com o Supabase / PostgreSQL (Utilize a porta 5432 para modo Session/Direct)
DATABASE_URL=postgresql://postgres.seu_projeto:sua_senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Parâmetros de Polling do Relay e Worker
RELAY_POLL_INTERVAL_SECONDS=2.0
RELAY_BATCH_SIZE=25
WORKER_BLOCK_MS=5000
MAX_JOB_RETRIES=3
